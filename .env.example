# Copy this file to .env and fill in values. Never commit .env.

# --- Email (required for --send) ---
# The only required setting. With no SMTP_HOST, the digest is delivered free
# through ntfy's email forwarding: no account, no API key, no SMTP server.
EMAIL_TO=you@example.com

# Optional: a self-hosted ntfy server instead of the public https://ntfy.sh
# NTFY_URL=https://ntfy.example.org
# Optional: force a provider (smtp or ntfy). Default: smtp if SMTP_HOST is set.
# EMAIL_PROVIDER=

# --- Optional SMTP (richer HTML email, your own sender address) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# true (default) uses STARTTLS on port 587. Set false and use port 465 for implicit TLS.
SMTP_STARTTLS=true

# --- Optional Adzuna source (skipped entirely if either is unset) ---
# Register at https://developer.adzuna.com/ — never commit real keys.
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# --- Optional visa-sponsorship classifier (only used when visa.classifier is true) ---
# https://console.anthropic.com/ — never commit a real key.
ANTHROPIC_API_KEY=

# --- Optional overrides ---
# DATABASE_PATH=data/seen_jobs.db
# PREFS_PATH=prefs.yaml
# HTTP_USER_AGENT=opportunities-abroad/0.1 (+https://github.com/jaspreetsingh0792/opportunities-abroad)
