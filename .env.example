# Copy this file to .env and fill in values. Never commit .env.

# --- Email (required for --send) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=alerts@example.com
EMAIL_TO=you@example.com
# true (default) uses STARTTLS on port 587. Set false and use port 465 for implicit TLS.
SMTP_STARTTLS=true

# --- Optional Adzuna source (skipped entirely if either is unset) ---
# Register at https://developer.adzuna.com/ — never commit real keys.
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# --- Optional overrides ---
# DATABASE_PATH=data/seen_jobs.db
# PREFS_PATH=prefs.yaml
# HTTP_USER_AGENT=opportunities-abroad/0.1 (+https://github.com/jaspreetsingh0792/opportunities-abroad)
